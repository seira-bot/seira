# Optional: Compose provides defaults when these settings are omitted.
COMPOSE_PROJECT_NAME=seira
SEIRA_BIND_ADDRESS=127.0.0.1
SEIRA_HTTP_PORT=8080
# Leave empty to use http://localhost:${SEIRA_HTTP_PORT:-8080}.
SEIRA_PUBLIC_URL=
# Extra https addresses for the phone pairing link, comma-separated (for example a tailnet name next to SEIRA_PUBLIC_URL).
SEIRA_PHONE_ROUTES=
# Leave empty to inherit SEIRA_PUBLIC_URL.
SEIRA_WEBHOOK_PUBLIC_URL=
# For Tailscale Serve, set the HTTPS hostname (without scheme or path).
# Set SEIRA_PUBLIC_URL to https:// followed by the same hostname.
# Requires SEIRA_BIND_ADDRESS=127.0.0.1 and a trusted local HTTPS proxy,
# or a bind address others can reach plus SEIRA_TRUSTED_PROXY_CIDRS.
SEIRA_HTTPS_HOST=
# Name the peers that may claim the HTTPS hostname (CIDRs, space separated).
# Required when SEIRA_HTTPS_HOST is set with any bind address but 127.0.0.1.
# Empty keeps the default: only the host itself can reach a loopback bind.
SEIRA_TRUSTED_PROXY_CIDRS=
SEIRA_BASE_IMAGE=ghcr.io/seira-bot/seira:latest
SEIRA_LOCAL_IMAGE=seira-local:latest
CADDY_IMAGE=caddy:2
# Explicitly empty ENGINES skips npm engine installation.
ENGINES="@anthropic-ai/claude-code @openai/codex"
# Leave empty for <COMPOSE_PROJECT_NAME>_data.
SEIRA_DATA_VOLUME=
# Use true only when reusing a volume that already exists.
SEIRA_DATA_EXTERNAL=false

# Admin token for cloudflare/updates/scripts/send-update.mjs.
SEIRA_UPDATES_ADMIN_TOKEN=

# Domain of the tunnel addresses (c-<32 hex>.<domain>) from your own control plane.
# Read only when SEIRA_CONTROL_PLANE_URL is also set. Seira's own seira.run is always accepted.
SEIRA_TUNNEL_HOST_SUFFIX=

# Phone push relay origin (https://, or http:// on loopback). Leave empty for Seira's push relay.
# An invalid value turns phone push off. The server enrolls itself there and keeps the credential in its data folder.
SEIRA_PUSH_RELAY_URL=

# Build time only. Address (https://) of the crash report service. Leave empty and the build sends no crash reports and has no switch.
SEIRA_CRASH_REPORT_URL=
# Build time only. Environment name that a report carries. Empty means production.
SEIRA_CRASH_REPORT_ENVIRONMENT=
# Release build only. Token that uploads source maps. Leave empty and the build only deletes the maps.
SENTRY_AUTH_TOKEN=
# Release build only. Organization of the source map upload.
SENTRY_ORG=
# Release build only. Project of the source map upload.
SENTRY_PROJECT=
# Release build only. Address of the source map service when it is not the default.
SENTRY_URL=
