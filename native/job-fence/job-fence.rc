// The version resource of seira-job-fence.exe: Windows shows it in the file's properties and in Task Manager.
#include <winver.h>

1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Seira"
      VALUE "FileDescription", "Seira bot memory limit"
      VALUE "FileVersion", "1.0.0"
      VALUE "InternalName", "seira-job-fence"
      VALUE "OriginalFilename", "seira-job-fence.exe"
      VALUE "ProductName", "Seira"
      VALUE "ProductVersion", "1.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
