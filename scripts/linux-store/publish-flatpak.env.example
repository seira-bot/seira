# Settings for scripts/linux-store/publish-flatpak.sh.
# Copy this file to a name that ends in .local, fill in your values, then load it:
#   set -a; . ./publish-flatpak.env.local; set +a
# Every variable has a default or is optional unless the text says "required".

# Public address of the repo. The script adds /repo/ to it.
SEIRA_FLATPAK_URL=https://flatpak.seira.bot

# R2 bucket name.
SEIRA_FLATPAK_BUCKET=seira-flatpak

# Name of the rclone remote for R2 (type s3, provider Cloudflare).
SEIRA_FLATPAK_RCLONE_REMOTE=seira-r2

# Path of the rclone config file that holds the R2 keys. Required for an upload.
# Keep the file at mode 600. Never commit it.
SEIRA_FLATPAK_RCLONE_CONFIG=

# Folder of the GnuPG home that holds the signing key (mode 700).
# Default: $XDG_CONFIG_HOME/seira/flatpak-gnupg
SEIRA_FLATPAK_GNUPGHOME=

# Signing key id or fingerprint. Default: the key in the committed public key file.
SEIRA_FLATPAK_GPG_KEY=

# Public key file. Default: packaging/flatpak/seira-flatpak.asc
SEIRA_FLATPAK_PUBLIC_KEY=

# Working folder. Default: $XDG_DATA_HOME/seira-flatpak
SEIRA_FLATPAK_DATA_DIR=

# Working copy of the repo. Default: $SEIRA_FLATPAK_DATA_DIR/repo
SEIRA_FLATPAK_CACHE_DIR=

# Build output. Default: $SEIRA_FLATPAK_DATA_DIR/build
SEIRA_FLATPAK_BUILD_DIR=

# flatpak-builder state (downloads cache). Default: $SEIRA_FLATPAK_DATA_DIR/builder-state
SEIRA_FLATPAK_STATE_DIR=

# Clean export of the tag that the build reads. Default: $SEIRA_FLATPAK_DATA_DIR/source
SEIRA_FLATPAK_SOURCE_DIR=

# Extra flatpak-builder arguments, for example --user when the runtimes are in the user installation.
SEIRA_FLATPAK_BUILDER_ARGS=
