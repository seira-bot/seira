#!/bin/sh
# Stops a commit that adds a file under a private path (scripts/check-public-paths.mjs), or whose added lines name a
# home folder, a private host, a user name or a secret (scripts/check-local-leaks.mjs). Skip once with
# `git commit --no-verify`, or for a session with SEIRA_SKIP_HOOKS=1.
if [ -n "$SEIRA_SKIP_HOOKS" ]; then
  echo "pre-commit: skipped (SEIRA_SKIP_HOOKS is set)"
  exit 0
fi
# Temporary: the old name still skips, and says it will go.
if [ -n "$OMB_SKIP_HOOKS" ]; then
  echo "pre-commit: skipped (OMB_SKIP_HOOKS is set; that name is deprecated and will be removed, use SEIRA_SKIP_HOOKS)"
  exit 0
fi
cd "$(git rev-parse --show-toplevel)" || exit 0
if [ ! -f scripts/check-local-leaks.mjs ] || ! command -v node >/dev/null 2>&1; then
  echo "pre-commit: no node in this checkout, so the leak check did not run"
  exit 0
fi
status=0
if [ -f scripts/check-public-paths.mjs ]; then
  node scripts/check-public-paths.mjs --staged || status=1
fi
node scripts/check-local-leaks.mjs --staged || status=1
exit "$status"
