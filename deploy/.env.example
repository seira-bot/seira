# Public hostname for automatic HTTPS (must resolve to this machine).
# Pairing links (`docker compose exec seira node dist-server/pair-cli.js`) point here.
DOMAIN=seira.example.com

# Engine CLIs baked into the image at build time (space-separated npm packages).
# Sign in afterwards with:  docker compose exec seira claude   (etc.)
ENGINES=@anthropic-ai/claude-code

# Optional: let people sign in with an emailed code instead of a pairing
# code. Addresses or @domain entries, comma-separated. Admins get full
# access; members get chat and approvals only. Left empty, Settings → Remote
# access manages the lists; one set here decides its list instead.
SEIRA_SIGNIN_EMAILS=
SEIRA_SIGNIN_MEMBER_EMAILS=

# Send those codes through your own mail server. Without one, emailed sign-in
# is off. Example: smtps://user%40example.com:PASSWORD@smtp.example.com:465
# (docs/self-hosting.md). FROM defaults to the user name when it is an address.
SEIRA_SIGNIN_SMTP_URL=
SEIRA_SIGNIN_SMTP_FROM=

# The server image this install runs. `./update.sh` writes this line: the stable
# version, pinned by digest. Leave it out to follow `latest` (every main push).
# SEIRA_IMAGE=

# Optional: "1" lets the Seira phone app pair by QR through Seira Relay,
# end-to-end encrypted, from anywhere. Needs an account service you run:
# set SEIRA_CONTROL_PLANE_URL to its https address. Sign the container in once:
#   docker compose exec seira seira login --relay
# then: docker compose exec seira seira pair --phone
SEIRA_CONTROL_PLANE_URL=
SEIRA_PHONE_RELAY=
