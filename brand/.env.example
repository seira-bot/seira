# Machine-specific values for the brand scripts.
# Copy this file to brand/.env.local and fill in the values for your machine.
# brand/.env.local is gitignored. Never commit it.
# The bash scripts load it through brand/load-env.sh. brand/build_logo.py reads it too.
# A value in the environment wins over the same value in brand/.env.local.

# Image generator for the mascot prompt scripts (brand/mascot/**/prompts.sh). Required for them.
# Contract: "$SEIRA_IMAGE_CMD" "PROMPT" OUT.png WIDTHxHEIGHT [REFERENCE.png]
# The command writes OUT.png and exits with 0 when it succeeds.
# Put other variables that your generator needs (model, key file) in brand/.env.local too.
SEIRA_IMAGE_CMD=

# Folder with the Geist Sans TTF files (Geist-Medium.ttf, Geist-SemiBold.ttf,
# Geist-Bold.ttf, Geist-ExtraBold.ttf) for brand/build_logo.py.
# Get Geist from https://github.com/vercel/geist-font (SIL Open Font License 1.1).
# Leave it empty to search the usual font folders.
SEIRA_FONT_DIR=

# Headless screenshots with brand/mascot/live/tools/shot.sh. All optional.
# SHOT_HOST: SSH host that renders the page. Empty = this machine.
SHOT_HOST=
SHOT_CHROMIUM=chromium
SHOT_MEM=2G
