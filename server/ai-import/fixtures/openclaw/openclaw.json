// OpenClaw config (JSON5)
{
  mcp: {
    servers: {
      fetch: { command: 'uvx', args: ['mcp-server-fetch'], },
      search: { url: "https://mcp.example.test/search", headers: { "X-Api-Key": "synthetic" } },
